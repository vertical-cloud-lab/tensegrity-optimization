@article{marsdenKillerPoresUsing,
  title = {Killer {{Pores}}: {{Using Machine Learning}} to {{Predict Fracture Location}} in {{Porous Tensile Specimens}}},
  author = {Marsden, Elliott and Baird, Sterling},
  pages = {12},
  abstract = {The production of metal components using AM (additive manufacturing) is a promising advancement in manufacturing technology. AM could allow production of geometrically complex components that couldn't be made using conventional subtractive techniques. Despite their potential, AM components contain extensive internal porosity and surface defects due to current printing techniques. These defects cause AM parts to have less fatigue and fracture resistance in comparison to their wrought counterparts. To ensure confidence in AM part application, quality control procedures must be established to find critical pores or pore clusters that might lead to premature failure. This paper reports the performance results of a machine learning model that predicts the NFL (nominal fracture location) in a uni-axially loaded finite element tensile specimen. After training on 100 unique pore networks, the model correctly predicted the NFL in 80\% of the 20 sample test set (error tolerance of 5\%). While promising, further data collection efforts should be conducted to improve prediction capabilities and statistical comparisons to prior methods.},
  langid = {english},
  file = {C:\Users\bairdst4\Zotero\storage\IPG8XM58\Marsden and Baird - Killer Pores Using Machine Learning to Predict Fr.pdf}
