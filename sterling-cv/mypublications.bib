@misc{tang_multitask_2025,
  title = {Multi-Task {{Attention}} for {{Doped Thermoelectric Properties Prediction}}},
  author = {Tang, Leng Ze and Mohanty, Trupti and Baird, Sterling G. and Ng, Leonard W. T. and Sparks, Taylor D.},
  year = 2025,
  month = sep,
  publisher = {ChemRxiv},
  doi = {10.26434/chemrxiv-2025-jcgjz},
  urldate = {2025-11-12},
  abstract = {Improving the performance of thermoelectric (TE) materials is essential for their wider adoption in sustainable energy and cooling applications. Impurity doping is a common strategy for enhancing transport properties, yet synthesizing every possible TE composition is infeasible, and high-fidelity ab initio simulations remains computationally expensive. Machine learning (ML) offers a viable alternative by learning a cheaper surrogate model, but due to the compositional similarity between doped and undoped materials, conventional approaches often struggle to capture the diverse doping effects. Addressing this challenge, we adapt the existing Compositionally restricted attention-based Network (CrabNet) into a multi-task variant, MT CrabNet, which uses self-attention to implicitly learn composition-specific dopant effects. Multi-task learning enables simultaneous predictions of seven TE transport properties, leveraging their interdependence to enhance performance. We also explore different strategies for encoding external variables such as the temperature. Trained on an experimental dataset covering over 1,400 unique compositions, MT CrabNet outperforms baseline models by up to 1.5 times in terms of R2. This establishes MT CrabNet as a useful tool for accelerating the screening and discovery of high-performance TE materials, with a design extensible to doped systems beyond the TE domain.},
  archiveprefix = {ChemRxiv},
  langid = {english},
  keywords = {attention mechanism,doped materials,figure of merit,machine learning,materials informatics,multi-task learning,thermoelectric}
}

