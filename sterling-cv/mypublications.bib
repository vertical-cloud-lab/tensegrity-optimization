@article{bairdFiveDegreeoffreedomProperty2021,
  title = {Five Degree-of-Freedom Property Interpolation of Arbitrary Grain Boundaries via {{Voronoi}} Fundamental Zone Framework},
  author = {Baird, Sterling G. and Homer, Eric R. and Fullwood, David T. and Johnson, Oliver K.},
  year = 2021,
