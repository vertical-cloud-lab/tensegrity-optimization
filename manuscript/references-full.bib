@article{lian2020formfindingofspine,
    author = {Lian, Oh Chai and Keong, Choong Kok and Nishimura, Toku and Jae-Yeol, Kim},
    title = {Form-Finding of Spine Inspired Biotensegrity Model},
    year = {2020},
