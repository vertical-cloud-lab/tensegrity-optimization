@article{butruille2024decouplingparticleimpactdissipation,
    author = {Butruille, Thomas and Crone, Joshua C. and Portela, Carlos M.},
    title = {Decoupling particle-impact dissipation mechanisms in 3D architected materials},
    year = {2024},
    journal = {Proceedings of the National Academy of Sciences of the United States of America},
    volume = {121},
    issue = {6},
    month = {Feb},
    publisher = {Proceedings of the National Academy of Sciences},
    doi = {10.1073/pnas.2313962121},
    url = {https://doi.org/10.1073/pnas.2313962121},
    issn = {0027-8424},
    abstract = {Significance Leveraging three-dimensional architecture in materials has led to well-characterized mechanical responses in the static realm, while their responses under extreme dynamic conditions remain a topic of active scientific exploration. Understanding the effect of architecture on energy dissipation or failure characteristics of advanced materials is necessary for the design of next-generation protective materials. Using a tabletop dynamic-impact framework for micro-architected materials, we demonstrate high-throughput characterization of their impact response to velocities of up to 850 m/s, which together with simulations provide insight into architecture-dependent energy dissipation mechanisms. This framework significantly expands the explored parameter space for architected materials and proposes a route for prediction of their dynamic behavior across length scales and impact conditions.}
}

