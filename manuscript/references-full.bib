@article{kim2016hoppingandrolling,
    author = {Kim, Kyunam and Chen, Lee-Huang and Cera, Brian and Daly, Mallory and Zhu, Edward and Despois, Julien and Agogino, Adrian K. and SunSpiral, Vytas and Agogino, Alice M.},
    title = {Hopping and rolling locomotion with spherical tensegrity robots},
