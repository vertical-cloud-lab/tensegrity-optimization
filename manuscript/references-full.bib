@article{pajunen2021prestraininducedbandgaptuning,
    author = {Pajunen, Kirsti and Celli, Paolo and Daraio, Chiara},
    title = {Prestrain-induced bandgap tuning in 3D-printed tensegrity-inspired lattice structures},
    year = {2021},
