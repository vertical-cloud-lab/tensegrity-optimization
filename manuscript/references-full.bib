@article{daglı2025mechanicalcharacterizationand,
    author = {Dağlı, Salih},
    title = {Mechanical Characterization and Interface Evaluation of Multi-Material Composites Manufactured by Hybrid Fused Deposition Modeling (HFDM)},
    year = {2025},
    journal = {Polymers},
    volume = {17},
    issue = {12},
    pages = {1631},
