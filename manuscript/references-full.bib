    issn = {1359-6454},
    abstract = {Cellular materials are fundamental elements in civil engineering, known for their porous nature and lightweight composition. However, the complexity of its microstructure and the mechanisms that control its behavior presents ongoing challenges. This comprehensive review aims to confront these uncertainties head-on, delving into the multifaceted field of cellular materials. It highlights the key role played by numerical and mathematical analysis in revealing the mysterious elasticity of these structures. Furthermore, the review covers a range of topics, from the simulation of manufacturing processes to the complex relationships between microstructure and mechanical properties. This review provides a panoramic view of the field by traversing various numerical and mathematical analysis methods. Furthermore, it reveals cutting-edge theoretical frameworks that promise to redefine our understanding of cellular solids. By providing these contemporary insights, this study}
}

