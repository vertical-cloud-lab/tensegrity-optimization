@article{cadoni2012structuralperformancesof,
    author = {Cadoni, Davide and Micheletti, Andrea},
    title = {Structural Performances of Single-layer Tensegrity Domes},
    year = {2012},
    journal = {International Journal of Space Structures},
    volume = {27},
    issue = {2-3},
    pages = {167-178},
    month = {Jun},
    publisher = {SAGE Publications},
    doi = {10.1260/0266-3511.27.2-3.167},
    url = {https://doi.org/10.1260/0266-3511.27.2-3.167},
    issn = {0956-0599},
    abstract = {We consider here floating-compression tensegrity systems: prestressed spatial trusses, composed by cables and struts, such that struts are never connected to each other. In particular, we focus on single-layer systems: all the nodal positions are assumed to lie on a closed synclastic surface, such as a sphere or an ellipsoid. In this study we perform the form-finding and the structural design of a new tensegrity dome of small size; then we compare it to a conventional truss structure. Theoretically, floating-compression systems are not the best choice for carrying loads, a fact which is confirmed in this study. Nevertheless, our tensegrity design improves previous ones significantly. The structural performances evaluated here provide a reference point for assessing the feasibility of floating-compression systems.}
}

