@article{sabelhaus2018designsimulationand,
    author = {Sabelhaus, Andrew P. and van Vuuren, Lara Janse and Joshi, Ankita and Zhu, Edward and Garnier, Hunter J. and Sover, Kimberly A. and Navarro, Jesus and Agogino, Adrian K. and Agogino, Alice M.},
